# ─── База данных ──────────────────────────────────────────────────────────────
# Подставляется автоматически интеграцией Supabase в Vercel. Локально скопируйте
# строку подключения из панели Supabase (Connection string → Transaction pooler).
POSTGRES_URL=postgres://user:password@host:6543/postgres

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Токен бота от @BotFather. НИКОГДА не попадает во фронтенд и в репозиторий.
TELEGRAM_BOT_TOKEN=
# Чат, куда приходят уведомления: напишите боту /start и возьмите id из getUpdates.
TELEGRAM_CHAT_ID=

# ─── Переключатели ────────────────────────────────────────────────────────────
# Приём событий аналитики. false — эндпоинт отвечает 200 и ничего не пишет.
ANALYTICS_ENABLED=true
# Отправка сообщений в Telegram. На локальной разработке держите false.
TELEGRAM_NOTIFICATIONS_ENABLED=true
# Подробный лог в консоль функции и в консоль браузера.
ANALYTICS_DEBUG=false

# Сколько дней хранить подробные события. Сессии и состояния калькулятора
# живут дольше — их чистит отдельный порог в два раза больше.
ANALYTICS_EVENT_RETENTION_DAYS=90

# Секрет для cron-эндпоинта: Vercel присылает его в заголовке Authorization.
CRON_SECRET=

# Домены, которым разрешено слать события (через запятую).
ALLOWED_ORIGINS=https://g0faq.ru,https://www.g0faq.ru,https://g0faq.github.io
