{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(css|js|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/flush",
      "schedule": "0 3 * * *"
    }
  ]
}
